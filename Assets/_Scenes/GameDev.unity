--- !u!114 &251434106
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 251434104}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Devices talk to each other by sending small packets of data across the
    network. In this room, the connections are the yellow lines. It\u2019s kind of
    like passing notes in class. One device writes the message, and the network delivers
    it to the right person.\n\nTo make sure nothing gets mixed up, every device has
    its own IP address, like a digital home address. When your computer sends something,
    the network reads the address and sends it to the right device.\n\nThe yellow
    line leading to the wall just connects to more computers in the outside world
    that house your games, account information, websites, and more. Note that every
    computer does not need to talk to each other. Even though not every computer
    needs to talk to each other, they can if the network lets them. All devices are
    connected through switches, routers, and cables, which act like the roads that
    carry data."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
